FLASK_ENV=development
FLASK_DEBUG=True
DATABASE_URL=sqlite:///reservations.db
OPENAI_API_KEY=your_api_key_here
CHATBOT_MODEL=gpt-3.5-turbo
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=reservation_db

# MHBot Integration (PERMA tracking)
# Auth uses OAuth2 password flow — provide username + password
MHBOT_BASE_URL=https://pchrd-ema.dlsu.edu.ph/backend
MHBOT_USERNAME=your_mhbot_username
MHBOT_PASSWORD=your_mhbot_password
# OR if you already have a static token, set this instead (skips auto-login):
MHBOT_API_TOKEN=
