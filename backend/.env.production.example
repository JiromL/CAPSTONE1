# Copy this file to .env and fill in real values for production.
# Never commit the real .env — it is in .gitignore.

FLASK_ENV=production

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cps_system

# Secrets — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate>
JWT_SECRET_KEY=<generate>

# Encryption — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<generate>

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=https://<your-render-url>/api/calendar/callback

# Email (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail>
SMTP_PASS=<16-char-app-password>
SMTP_FROM_EMAIL=<your-gmail>

# Frontend URL (your Vercel URL)
FRONTEND_URL=https://<your-app>.vercel.app

# Zoom
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# EMA / MHBot
MHBOT_BASE_URL=https://pchrd-ema.dlsu.edu.ph/backend
EMA_ADMIN_USERNAME=
EMA_ADMIN_PASSWORD=

# SMS (Semaphore)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=DLSUCPS

# Organisation
ORG_NAME=Counseling & Psychological Services
ORG_UNIVERSITY=De La Salle University
ORG_SHORT=DLSU CPS
SUPPORT_EMAIL=cps@dlsu.edu.ph
ALLOWED_EMAIL_DOMAIN=@dlsu.edu.ph
